    "deploy:base": "hardhat run scripts/deploy-base.js --network baseSepolia",
    "deploy:story": "hardhat run scripts/deploy-story.js --network storyAeneid",
    "deploy:oft": "hardhat run scripts/deploy-oft.js --network",
    "deploy:oft-krump": "hardhat run scripts/deploy-oft-krump.js --network",
    "deploy:evvm-adapter": "hardhat run scripts/deploy-evvm-adapter.js --network storyAeneid",
    "link:oft": "hardhat run scripts/link-oft.js",
    "link:oft-krump": "hardhat run scripts/link-oft-krump.js",
    "verify:story": "hardhat run scripts/verify-story-aeneid.js --network storyAeneid",
    "verify:base-sepolia": "hardhat run scripts/verify-base-sepolia.js --network baseSepolia",
    "verify:evvm-adapter": "hardhat run scripts/verify-evvm-adapter.js --network storyAeneid",
