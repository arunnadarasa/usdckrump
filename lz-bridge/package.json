    "verify:bridge-evvm-adapter": "hardhat run scripts/verify-bridge-evvm-adapter.js --network storyAeneid",
    "test:bridge": "hardhat run scripts/test-bridge.js",
    "test:cross-chain": "hardhat run scripts/test-cross-chain.js --network baseSepolia",
    "test:evvm": "hardhat run scripts/test-evvm.js --network storyAeneid",
    "test:x402": "hardhat run scripts/test-x402-payment.js --network storyAeneid",
    "test:x402-bridge": "hardhat run scripts/test-x402-bridge.js --network storyAeneid",
