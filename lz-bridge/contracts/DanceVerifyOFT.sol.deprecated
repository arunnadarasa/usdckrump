pragma solidity ^0.8.20;

import {OFTv2} from "@layerzero/oftv2/contracts/OFTv2.sol";
import {IOFTv2} from "@layerzero/oftv2/contracts/interfaces/IOFTv2.sol";

contract DanceVerifyOFT is OFTv2 {
    address public danceVerifyBackend;
    
    event PaymentReceived(
        address indexed from,
        uint256 amount,
        string receiptId,
        uint256 timestamp
    );
    
    constructor(
        string memory _name,
        string memory _symbol,
        uint8 _decimals,
        address _endpoint,
        address _backend
    ) OFTv2(_name, _symbol, _decimals, _endpoint) {
        danceVerifyBackend = _backend;
    }
    
    /**
     * Called by LayerZero when tokens arrive from remote chain
     */
    function lzReceive(
        uint16 _srcChainId,
        bytes calldata _srcAddress,
        uint64, // _nonce
        bytes calldata _payload
    ) external override onlyEndpoint {
        // Decode payload: (address originalSender, uint256 amount, string receiptId)
        (address from, uint256 amount, string memory receiptId) = 
            abi.decode(_payload, (address, uint256, string));
        
        require(amount > 0, "Invalid amount");
        
        // Tokens are auto-minted by OFTv2 when burn proof is validated
        // Our contract balance increases
        
        emit PaymentReceived(from, amount, receiptId, block.timestamp);
        
        // Optional: Emit event for backend to catch and process verification
        // Backend can call getPaymentInfo(receiptId) to confirm
    }
    
    /**
     * Agent calls this to pay for verification via LayerZero
     */
    function payViaLayerZero(
        uint16 _dstChainId,
        bytes32 _recipient, // destination contract address in bytes32
        uint256 _amount,
        string memory _receiptId
    ) external {
        bytes memory payload = abi.encode(
            msg.sender, // original sender
            _amount,
            _receiptId
        );
        
        // Burn on source, will mint on destination after DVN validation
        super.send(
            _dstChainId,
            _recipient,
            _amount,
            payload,
            address(0), // refund address
            bytes(""),  // options
            false        // execute (not estimate)
        );
    }
    
    /**
     * Get payment info (for backend verification)
     */
    function getPaymentInfo(string memory receiptId)
        external
        view
        returns (
            address depositor,
            uint256 amount,
            uint256 timestamp,
            bool exists
        )
    {
        // We could store this in a mapping if needed
        // For simplicity, backend can listen to PaymentReceived event
        return (address(0), 0, 0, false);
    }
    
    modifier onlyEndpoint() {
        require(msg.sender == endpoint(), "Only endpoint");
        _;
    }
}
